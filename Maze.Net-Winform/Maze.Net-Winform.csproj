<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Maze.TApplication</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
	<ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maze.Net\Maze.Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="control\CircularMazeControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="control\CircularHexagonMazeControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="control\HexagonalMazeControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="control\CustomizedMazeControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="control\StairwayMazeControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="control\TriangularMazeControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="control\HoneycombMazeControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

</Project>